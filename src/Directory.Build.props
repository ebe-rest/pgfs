<Project>

  <!--
    Shared assembly metadata for every project under src (core / fuse / mkfs / mount / assign).
    The startup banner (Pgfs.Core.AppInfo) reads the Version / Product / Copyright set here at runtime.
  -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>pgfs</Product>
    <Company>ebe-rest</Company>
    <Authors>ebe-rest</Authors>
    <Copyright>Copyright (c) 2026 ebe-rest</Copyright>
  </PropertyGroup>

</Project>
