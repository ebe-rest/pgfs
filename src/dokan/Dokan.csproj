<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Pgfs.Dokan</RootNamespace>
		<AssemblyName>dokan.pgfs</AssemblyName>
		<!--
			The filesystem mechanism layer for Windows: the DokanNet binding plus the Dokan
			FileSystem implementation.

			Output layout:
			  dotnet build -c Debug|Release -> bin/{Debug,Release}/dokan.pgfs.dll
			  dotnet publish                -> nothing (bundled into the assign.pgfs single file)

			Windows-only code, but it still builds on Linux/macOS so it can be cross-compiled
			([SupportedOSPlatform] guards the entry points).
		-->
		<BaseOutputPath>$(MSBuildThisFileDirectory)..\..\bin\</BaseOutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<IsPublishable>false</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<!-- Per-OS symbols. -->
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<DefineConstants>$(DefineConstants);LINUX</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<DefineConstants>$(DefineConstants);MACOS</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DokanNet" Version="2.3.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\core\Core.csproj" />
	</ItemGroup>

</Project>
