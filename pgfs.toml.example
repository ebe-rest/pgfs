# Sample pgfs settings file. Copy to pgfs.toml and edit.
#
# Every value is optional; when omitted, the Schema default is used.
# CLI arguments (`-c`, `-m`, etc.) take precedence over this file.
# Details: docs/Mkfs.md

# ----- database connection -----
database.connection.host = "localhost"
database.connection.port = "5432"
database.connection.username = "pgfs"
database.connection.password = "pgfs"
database.connection.database = "pgfs"
database.connection.ssl_mode = "Prefer"

# ----- database structure -----
database.schema = "public"
database.prefix = "pgfs_"
# database.tablespace / database.tablespace_path are SaveTo=DB fs-identifying info (set via mkfs
# `--tablespace` / `--tablespace-path` → stored in pgfs_settings). They are not written to the generated
# toml. Overriding them via a config file is not intended (same handling as the file_system keys below).

# ----- file system settings (fixed at FS creation) -----
# file_system.* (cluster_size / default_chunk_size / max_file_size / volume_label / version) and
# app.statfs / database.citus / app.plperlu are SaveTo=DB fs-identifying info. They are stored into
# pgfs_settings at mkfs time and read from there by all clients. **Not written to toml** (and not
# emitted to the generated toml). In particular, a mismatch of cluster_size / default_chunk_size across
# clients can corrupt data, so a single DB authority is correct.
# NB: if you hand-write them, they are read per spec and the TOML value takes precedence, but breakage
#     is at your own risk (an escape hatch for temporarily changing a value during development).
#     Details: docs/settings-and-plperlu.md

# ----- mount -----
# mount.mount_point = "/mnt/pgfs"             # Linux/macOS. On Windows, e.g. "P:"
# mount.cache_max_entries = 1024
# mount.fallback_uname = "nobody"             # fallback when uname resolution fails (on Windows, e.g. "Guest")
# mount.fallback_gname = "nogroup"            # fallback when gname resolution fails (on Windows, "Guests")
# Note: fallback_uname / fallback_gname are SaveTo=DB, so they are read from pgfs_settings.
# Specifying them in pgfs.toml takes precedence over the DB value (like a CLI argument), but when
# mounting the same FS from multiple machines, the intended operation is to manage them centrally on
# the DB side (at mkfs time or via a later UPDATE).

# ----- database connection retry -----
# database.retry_max_attempts = 5             # max attempts (including the first) on a transient failure at connection open
# database.retry_initial_delay_ms = 200       # initial backoff delay (ms)
# database.retry_max_delay_ms = 2000          # exponential-backoff ceiling (ms)

# ----- logging -----
# logging.level = "information"               # all / trace / debug / information / warning / error / critical / none
# logging.output = "stderr"                   # stdout / stderr / none / "<cycle>:<dir>/<pattern>"
#   example of file output (date rotation):
#     logging.output = "daily:~/pgfs/log/pgfs-*.log"     # ~/pgfs/log/pgfs-YYYYMMDD.log (daily)
#   cycle = none / hourly / daily / monthly. A "*" in the pattern is replaced by the date
#     (hourly=yyyyMMddHH / daily=yyyyMMdd / monthly=yyyyMM / none=empty). "~" expands to home.
